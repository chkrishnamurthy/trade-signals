{
  "name": "nse-signal-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @signal/db db:generate",
    "db:migrate": "pnpm --filter @signal/db db:migrate",
    "db:studio": "pnpm --filter @signal/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.19.4",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
