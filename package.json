{
  "name": "equitywise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @equitywise/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @equitywise/db db:generate",
    "db:migrate": "pnpm --filter @equitywise/db db:migrate",
    "db:studio": "pnpm --filter @equitywise/db db:studio",
    "verify:adjustment": "tsx scripts/verify-adjustment.ts",
    "fyers:login": "tsx scripts/fyers-login.ts",
    "clean": "pnpm -r clean && rm -rf apps/web/.next",
    "verify:intraday": "tsx scripts/verify-intraday.ts",
    "backtest:intraday": "tsx scripts/backtest-intraday.ts",
    "backtest:prune": "tsx scripts/prune-backtests.ts",
    "backfill:minutes": "tsx scripts/backfill-minutes.ts",
    "replay:session": "tsx scripts/replay-session.ts",
    "data:coverage": "tsx scripts/coverage.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@equitywise/core": "workspace:*",
    "@equitywise/db": "workspace:*",
    "@equitywise/fyers": "workspace:*",
    "@equitywise/shared": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
