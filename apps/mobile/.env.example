# Copy to .env.local (gitignored). Only EXPO_PUBLIC_* values reach the phone —
# never put a secret here.

# Where the app's API lives. With the phone on USB and `adb reverse tcp:3000 tcp:3000`
# this is your Mac's `pnpm dev:web`. Over Wi-Fi use http://<your-mac-LAN-ip>:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000
APP_VARIANT=development
