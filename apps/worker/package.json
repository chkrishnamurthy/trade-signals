{
  "name": "@equitywise/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "WORKER_MINT_CREDENTIALS=false tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@equitywise/core": "workspace:*",
    "@equitywise/db": "workspace:*",
    "@equitywise/market-data": "workspace:*",
    "@equitywise/providers-dhan": "workspace:*",
    "@equitywise/providers-fyers": "workspace:*",
    "@equitywise/shared": "workspace:*",
    "croner": "^9.0.0",
    "dotenv": "^17.4.2",
    "read-excel-file": "9.3.10",
    "unpdf": "^1.8.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
