# ---------------------------------------------------------------------------
# Neon Postgres
# ---------------------------------------------------------------------------
# Both strings point at the SAME database. They differ only in which Neon
# endpoint host they resolve to. Using the wrong one is a real bug:
#
#   DATABASE_URL         -> POOLED  (host contains "-pooler")
#                           PgBouncer in transaction mode. Use for the web app,
#                           the worker's normal query path, and anything that
#                           opens many short-lived connections. Neon's compute
#                           can scale to zero behind it.
#
#   DATABASE_URL_DIRECT  -> DIRECT  (host WITHOUT "-pooler")
#                           A real Postgres connection. Required for anything
#                           that needs session state: drizzle-kit migrations,
#                           `drizzle-kit studio`, COPY, CREATE EXTENSION,
#                           advisory locks. Migrations WILL fail on the pooled
#                           string.
#
# Where to find them in the Neon console:
#   1. https://console.neon.tech -> select your project
#   2. Dashboard -> "Connection string" panel (or Project settings -> Connect)
#   3. Choose branch = production (or your dev branch), database, and role
#   4. Toggle "Connection pooling":
#        ON  -> copy into DATABASE_URL         (host: ep-xxx-pooler.<region>.aws.neon.tech)
#        OFF -> copy into DATABASE_URL_DIRECT  (host: ep-xxx.<region>.aws.neon.tech)
#   5. Neon hands you `?sslmode=require`. Change it to `?sslmode=verify-full`
#      on both, as below. node-postgres already treats `require` as
#      `verify-full`, and warns that it will stop doing so in pg v9; saying
#      `verify-full` outright is identical today and immune to that change.
#      Neon rejects unencrypted connections either way.
#
# The password is only shown once at role creation; use "Reset password" on the
# role if you lose it.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.ap-southeast-1.aws.neon.tech/nse_signals?sslmode=verify-full"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/nse_signals?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Neon API (test-branch automation only — not needed to run the app)
# ---------------------------------------------------------------------------
# The schema test suite creates a throwaway Neon branch, migrates it, asserts
# against it, and deletes it. That needs an API key:
#   1. https://console.neon.tech -> Account settings -> API keys
#   2. "Create new API key", copy it (shown once)
# An account-scoped key can reach every project on the account; prefer an
# org- or project-scoped key if one is available to you.
#
# Leave this unset and the schema tests skip rather than fail.
NEON_API_KEY=""
# Project the test branches are created in. Neon console -> Project settings ->
# General -> "Project ID", or `GET /api/v2/projects?org_id=<org>`.
NEON_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Fyers API v3
# ---------------------------------------------------------------------------
# Create an app at https://fyers.in/web/api-dashboard/user-apps
#   - Redirect URI must match FYERS_REDIRECT_URI below exactly.
#   - "Market Data" permission is required for history and quotes.
#   - Since 1 Apr 2026 SEBI requires a separate, IP-whitelisted app for ORDER
#     placement. A data-only app needs no static IP.
FYERS_APP_ID=""            # e.g. SPXXXXE7-100
FYERS_SECRET_KEY=""        # app secret; never commit
FYERS_REDIRECT_URI="https://trade.fyers.in/api-login/redirect-uri/index.html"

# Access token. Expires daily — the refresh-token flow was discontinued on
# 1 Apr 2026 and daily 2FA is now mandatory.
# Get one manually: open buildAuthCodeUrl(), log in, copy auth_code from the
# redirect URL, then exchangeAuthCode(). Or set the three fields below for
# automated TOTP re-login.
FYERS_ACCESS_TOKEN=""

# Optional: headless daily re-login. Uses UNDOCUMENTED Fyers endpoints that may
# break without notice; failures degrade to a FyersAuthError asking you to log
# in by hand. Leave blank to always log in manually.
FYERS_ID=""                # your FYERS login ID, e.g. XK12345
FYERS_TOTP_SECRET=""       # base32 secret from 2FA setup
FYERS_PIN=""               # 4-digit login PIN

# ---------------------------------------------------------------------------
# Clerk (authentication)
# ---------------------------------------------------------------------------
# The web app is closed by default: every route and every /api route requires a
# session. Create an application at https://dashboard.clerk.com and copy the two
# keys from "API keys".
#
#   1. Dashboard -> your application -> Configure -> API keys
#   2. Copy the Publishable key into NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#      (pk_test_... in development, pk_live_... in production)
#   3. Copy the Secret key into CLERK_SECRET_KEY (sk_test_... / sk_live_...)
#
# NEXT_PUBLIC_ is the ONLY prefix Next inlines into the browser bundle. The
# publishable key is designed to be public; CLERK_SECRET_KEY is not, and must
# never gain that prefix — nor may DATABASE_URL or any FYERS_* value.
#
# Sign-in and sign-up live at /sign-in and /sign-up inside the app; those URLs
# are set in code (ClerkProvider and the middleware), not here.
#
# This is a single-user tool. Turn on Restrictions -> "Allowlist" in the Clerk
# dashboard and add your own email, otherwise anyone who finds the host can
# create an account.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Deploying apps/web to Netlify
# ---------------------------------------------------------------------------
# THIS FILE IS NOT DEPLOYED. `.env` is gitignored and `next.config.ts` only
# dotenv-loads it from the repo root on a developer machine — on Netlify that
# file does not exist and the load silently does nothing. Every value the build
# or the serverless functions need must be set in the Netlify UI:
#
#   Site configuration -> Environment variables -> Add a variable
#
# Leave each one at Netlify's default "all scopes". The Clerk publishable key is
# read at BOTH ends — the build bakes it into the prerendered pages, the
# middleware reads it on every request — and the rest are read at request time,
# so a variable scoped to "Builds" only leaves the deployed site broken even
# though the deploy is green:
#
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY   pk_live_... (or pk_test_...)
#   CLERK_SECRET_KEY                    sk_live_... / sk_test_...
#   DATABASE_URL                        the POOLED Neon string
#
# `next build` does NOT fail when the Clerk keys are absent. `clerkMiddleware`
# throws instead, on every request, so the whole site answers 500 — /sign-in
# included, because the middleware runs before it. That is the error you are
# reading if a successful deploy serves nothing.
#
# Because the publishable key reaches the browser, it also lands in the deploy
# output, where Netlify's secrets scanner would find it and fail the build.
# `netlify.toml` exempts that one key by name via SECRETS_SCAN_OMIT_KEYS. Never
# add another key to that list — a scanner hit on CLERK_SECRET_KEY, DATABASE_URL
# or any FYERS_* value is a real leak.
#
# Required only for the live-quote routes; everything backed by the database
# works without them:
#
#   FYERS_APP_ID
#   FYERS_ACCESS_TOKEN
#
# Do NOT set DATABASE_URL_DIRECT, FYERS_SECRET_KEY, FYERS_TOTP_SECRET,
# FYERS_PIN or NEON_API_KEY on Netlify. Migrations, the OAuth handshake and the
# test-branch automation all run from a developer machine or the worker; the web
# app never needs them, and an unused secret is still a secret at risk.
#
# Scope every variable to "Builds" and "Functions" (Netlify's default is all
# scopes, which is fine). Deploy previews and branch deploys get the same values
# unless you override them — for a pk_test_/sk_test_ pair on previews, use
# Netlify's per-context values.
#
# Two things that do NOT work on a Netlify deploy, by nature rather than by
# configuration:
#
#   - /login and /callback (the Fyers OAuth handshake) write the new token into
#     .fyers-token.json and this repo's .env. A serverless filesystem is
#     read-only and ephemeral, so re-authorising must be done locally and the
#     resulting FYERS_ACCESS_TOKEN pasted into the Netlify UI. The token expires
#     daily.
#   - apps/worker does not run here. Nothing writes new candles, signals or
#     paper trades while only Netlify is deployed; the site serves whatever the
#     worker last stored.
