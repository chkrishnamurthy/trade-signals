{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "web-live",
      "url": "http://localhost:3000"
    },
    {
      "name": "tracker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "tracker", "dev"],
      "port": 4321
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@equitywise/web", "storybook", "--no-open"],
      "port": 6006
    }
  ]
}
