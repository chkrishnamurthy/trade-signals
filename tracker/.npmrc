# tracker is a standalone project that happens to live under a folder containing
# a pnpm-workspace.yaml (which globs only apps/* and packages/*). Without this,
# pnpm treats tracker as part of that workspace and mislinks its dependencies
# (e.g. @vitejs/plugin-react resolves to the repo-root store and goes missing).
# Ignoring the workspace makes `pnpm install` / `pnpm dev` here self-contained.
ignore-workspace=true
