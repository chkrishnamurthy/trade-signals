# Workspace packages are linked from source, never fetched from a registry.
link-workspace-packages=true
prefer-workspace-packages=true
# Keep the store strict so a package cannot import a dependency it does not declare.
auto-install-peers=true
strict-peer-dependencies=false
# Scripts run in pnpm's built-in shell, so `VAR=x cmd` and `rm -rf` work on Windows too.
shell-emulator=true
